{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/components/ParentCouncil",
    "src/components/StudentNeedsSurvey",
    "src/components/AttendanceSystem.tsx",
    "src/components/CampaignMonitor.tsx",
    "src/components/ConnectionPanel.tsx",
    "src/components/ConsolidatedStudentReportModal.tsx",
    "src/components/DatabaseManagementModal.tsx",
    "src/components/DisciplineReportsPrinter.tsx",
    "src/components/ExcelAbsenceImporter.tsx",
    "src/components/ExcelUploader.tsx",
    "src/components/GuidanceAbsenceWorkflow.tsx",
    "src/components/GuidanceDocumentModal.tsx",
    "src/components/HomeDashboard.tsx",
    "src/components/IndividualSender.tsx",
    "src/components/LoginScreen.tsx",
    "src/components/MessagesTab.tsx",
    "src/components/NoorImporterModal.tsx",
    "src/components/ParentStudentSupportPortal.tsx",
    "src/components/ReportsPrinter.tsx",
    "src/components/SchedulePreviewWorkbench.tsx",
    "src/components/SchoolSignatoriesModal.tsx",
    "src/components/StudentInquiry.tsx",
    "src/components/Sidebar.tsx",
    "src/components/StudentHealthTracker.tsx",
    "src/components/StudentSupportDetailModal.tsx",
    "src/components/TeacherEvaluationPortal.tsx",
    "src/components/TeachersScheduleManager.tsx",
    "src/components/TeacherSupportCardModal.tsx",
    "src/components/UserManagement.tsx",
    "src/types/parentCouncil.ts",
    "src/types/studentSupport.ts",
    "src/types/studentNeedsSurvey.ts",
    "src/utils/chromeExtensionBuilder.ts",
    "src/utils/noorBookmarklet.ts",
    "src/utils/noorSmartParser.ts",
    "src/utils/parentCouncilUtils.ts",
    "src/utils/studentNeedsRulesEngine.ts",
    "src/utils/studentSupportRulesEngine.ts",
    "src/utils/teachersScheduleParser.ts"
  ]
}
