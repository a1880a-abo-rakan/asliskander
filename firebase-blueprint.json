{
  "entities": {
    "Settings": {
      "title": "Settings",
      "description": "Application governance configuration and targets",
      "type": "object",
      "properties": {
        "رسوم_مدى": { "type": "number", "description": "Mada terminal transaction fee percentage" },
        "رسوم_فيزا": { "type": "number", "description": "Visa card fee percentage" },
        "صرف_افتراضي": { "type": "number", "description": "Default branch start drawer cache amount" },
        "سقف_بيبسي": { "type": "number", "description": "Standard daily pepsi limit" },
        "سقف_بلاستيك": { "type": "number", "description": "Standard daily plastics limit" },
        "سقف_صلصات": { "type": "number", "description": "Standard daily sauces limit" },
        "سقف_ديزل_قادسية": { "type": "number", "description": "Standard daily diesel limit for Al-Qadsiah branch" },
        "سقف_ديزل_مروج": { "type": "number", "description": "Standard daily diesel limit for Al-Murooj branch" },
        "زيادة_عالي": { "type": "number", "description": "Percentage increase in cap trigger limit trigger ratio for high sales days" },
        "نسبة_قادسية_ديزل": { "type": "number", "description": "Shared diesel cost percentage for Al-Qadsiah branch" },
        "نسبة_مروج_ديزل": { "type": "number", "description": "Shared diesel cost percentage for Al-Murooj branch" },
        "ايام_مقارنة": { "type": "number", "description": "Period window in days to contrast performance against averages" }
      },
      "required": ["رسوم_مدى", "رسوم_فيزا", "صرف_افتراضي"]
    },
    "DailyEntry": {
      "title": "DailyEntry",
      "description": "Financial and ledger entry recorded daily per branch",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique key matching branch-date" },
        "date": { "type": "string", "description": "Entry date formatted as YYYY-MM-DD" },
        "branch": { "type": "string", "description": "Branch name ('القادسية' or 'المروج')" },
        "sarf": { "type": "number", "description": "Actual start day float" },
        "cash_box": { "type": "number", "description": "EOD box physical cash balance" },
        "cash_purchases": { "type": "number", "description": "Sum of total raw materials paid via drawer cash outlays" },
        "pur_gas": { "type": "number" },
        "pur_bread": { "type": "number" },
        "pur_veg": { "type": "number" },
        "pur_groc": { "type": "number" },
        "mada1": { "type": "number" },
        "mada2": { "type": "number" },
        "mada3": { "type": "number" },
        "visa1": { "type": "number" },
        "visa2": { "type": "number" },
        "visa3": { "type": "number" },
        "pos_net": { "type": "number" },
        "cash_net": { "type": "number" },
        "total_sales": { "type": "number" },
        "makhzan": { "type": "number" },
        "pepsi_paid": { "type": "number" },
        "pepsi_type": { "type": "string" },
        "pepsi_carry_prev": { "type": "number" },
        "pepsi_deduct": { "type": "number" },
        "pepsi_carry_next": { "type": "number" },
        "plastic_paid": { "type": "number" },
        "plastic_type": { "type": "string" },
        "plastic_carry_prev": { "type": "number" },
        "plastic_deduct": { "type": "number" },
        "plastic_carry_next": { "type": "number" },
        "sauces_paid": { "type": "number" },
        "sauces_type": { "type": "string" },
        "sauces_carry_prev": { "type": "number" },
        "sauces_deduct": { "type": "number" },
        "sauces_carry_next": { "type": "number" },
        "gas": { "type": "number" },
        "vegetables": { "type": "number" },
        "bread": { "type": "number" },
        "grocery": { "type": "number" },
        "diesel_paid": { "type": "number" },
        "diesel_type": { "type": "string" },
        "diesel_carry_prev": { "type": "number" },
        "diesel_deduct": { "type": "number" },
        "diesel_carry_next": { "type": "number" },
        "fixed_deduct": { "type": "number" },
        "fixed_note": { "type": "string" },
        "notes": { "type": "string" },
        "pepsi_cap": { "type": "number" },
        "plastic_cap": { "type": "number" },
        "sauces_cap": { "type": "number" },
        "diesel_cap": { "type": "number" },
        "net_day": { "type": "number" }
      },
      "required": ["id", "date", "branch", "cash_box"]
    },
    "SharedDiesel": {
      "title": "SharedDiesel",
      "description": "Consolidated diesel procurement cost bills that are shared across branches",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "total": { "type": "number" },
        "notes": { "type": "string" },
        "q_share": { "type": "number" },
        "m_share": { "type": "number" }
      },
      "required": ["id", "date", "total"]
    },
    "TaxInvoice": {
      "title": "TaxInvoice",
      "description": "Official supplier tax invoice registered in the books",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "branch": { "type": "string" },
        "company": { "type": "string" },
        "invoice_no": { "type": "string" },
        "invoice_date": { "type": "string" },
        "amount": { "type": "number" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "qty": { "type": "string" },
              "price_with_tax": { "type": "number" }
            },
            "required": ["name", "price_with_tax"]
          },
          "description": "Itemized list of purchases parsed from invoice with names and prices after tax"
        }
      },
      "required": ["id", "date", "branch", "amount"]
    },
    "UnifiedUser": {
      "title": "UnifiedUser",
      "description": "System user account with specific role-based permissions and status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Equal to username" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string", "enum": ["مدير", "محاسب", "مدخل فواتير"] },
        "status": { "type": "string", "enum": ["نشط", "موقوف"] },
        "branch": { "type": "string", "enum": ["الكل", "القادسية", "المروج"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "username", "displayName", "password", "role", "status"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Registered restaurant staff profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "job": { "type": "string" },
        "salary": { "type": "number" },
        "advanceLimitPercent": { "type": "number" },
        "requiredArrivalTime": { "type": "string" },
        "requiredDepartureTime": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "job", "salary", "advanceLimitPercent", "requiredArrivalTime", "requiredDepartureTime"]
    },
    "EmployeeAdvance": {
      "title": "EmployeeAdvance",
      "description": "Salary advance and loan ledger",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "employeeId", "employeeName", "date", "amount"]
    },
    "EmployeeAttendance": {
      "title": "EmployeeAttendance",
      "description": "Employee official day shift arrival/lateness tracking sheet",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "date": { "type": "string" },
        "arrivalTime": { "type": "string" },
        "departureTime": { "type": "string" },
        "latenessMinutes": { "type": "number" },
        "deductionAmount": { "type": "number" },
        "oralWarning": { "type": "boolean" },
        "latenessCategory": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "employeeId", "employeeName", "date", "arrivalTime", "departureTime", "latenessMinutes", "deductionAmount"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Smart tracked supply purchase record and stock level locator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Arabic item name, e.g. خبز or ديزل" },
        "date": { "type": "string", "description": "Purchase transaction date format (YYYY-MM-DD)" },
        "qty": { "type": "string", "description": "Quantified quantity details or financial entry text" },
        "type": { "type": "string", "enum": ["direct", "split"] },
        "price": { "type": "number", "description": "Direct cost value" },
        "branch": { "type": "string", "description": "Affiliated branch ('القادسية' or 'المروج')" },
        "status": { "type": "string", "enum": ["active", "depleted"] },
        "source": { "type": "string", "enum": ["manual", "invoice"] },
        "depletedDate": { "type": "string" },
        "invoiceId": { "type": "string" }
      },
      "required": ["id", "name", "date", "price", "branch", "status"]
    },
    "WhatsAppSettings": {
      "title": "WhatsAppSettings",
      "description": "System WhatsApp gateway gateway and pairing configuration state",
      "type": "object",
      "properties": {
        "phoneNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["disconnected", "pairing_requested", "connected"] },
        "pairingCode": { "type": "string" },
        "qrCodeUrl": { "type": "string" },
        "requestedAt": { "type": "string" },
        "linkedAt": { "type": "string" }
      },
      "required": ["status"]
    },
    "WhatsAppMessage": {
      "title": "WhatsAppMessage",
      "description": "Sent broadcast alert logs registry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "recipientPhone": { "type": "string" },
        "messageType": { "type": "string", "enum": ["custom", "warning", "advance", "salary"] },
        "messageText": { "type": "string" },
        "status": { "type": "string" },
        "sentAt": { "type": "string" }
      },
      "required": ["id", "employeeName", "recipientPhone", "messageText", "status", "sentAt"]
    },
    "TaxCompany": {
      "title": "TaxCompany",
      "description": "Tax registered suppliers and companies list",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "BakeryEntry": {
      "title": "BakeryEntry",
      "description": "Bakery reconciliation and adjustment tracking per date and branch",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "branch": { "type": "string", "enum": ["القادسية", "المروج"] },
        "arrived_turkish_large": { "type": "number" },
        "arrived_turkish_small": { "type": "number" },
        "arrived_italian": { "type": "number" },
        "arrived_samouli": { "type": "number" },
        "arrived_samoon_small": { "type": "number" },
        "arrived_samoon_large": { "type": "number" },
        "sold_sarokh_turkish": { "type": "number" },
        "sold_sandwich_small": { "type": "number" },
        "sold_sarokh_double": { "type": "number" },
        "sold_shawarma_arabic_small": { "type": "number" },
        "sold_shawarma_arabic_medium": { "type": "number" },
        "sold_shawarma_arabic_large": { "type": "number" },
        "sold_iskander_small": { "type": "number" },
        "sold_iskander_medium": { "type": "number" },
        "sold_iskander_large": { "type": "number" },
        "sold_iskander_italian": { "type": "number" },
        "sold_sarokh_samouli": { "type": "number" },
        "sold_shawarma_iraqi_small": { "type": "number" },
        "sold_shawarma_iraqi_large": { "type": "number" },
        "wasted_turkish_large": { "type": "number" },
        "wasted_turkish_small": { "type": "number" },
        "wasted_italian": { "type": "number" },
        "wasted_samouli": { "type": "number" },
        "wasted_samoon_small": { "type": "number" },
        "wasted_samoon_large": { "type": "number" },
        "staff_turkish_large": { "type": "number" },
        "staff_turkish_small": { "type": "number" },
        "staff_italian": { "type": "number" },
        "staff_samouli": { "type": "number" },
        "staff_samoon_small": { "type": "number" },
        "staff_samoon_large": { "type": "number" },
        "shared_turkish_large": { "type": "number" },
        "shared_turkish_small": { "type": "number" },
        "shared_italian": { "type": "number" },
        "shared_samouli": { "type": "number" },
        "shared_samoon_small": { "type": "number" },
        "shared_samoon_large": { "type": "number" },
        "actual_sales": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "date", "branch"]
    },
    "DrinkItemState": {
      "type": "object",
      "properties": {
        "prev_stock": { "type": "number" },
        "arrived_cartons": { "type": "number" },
        "sold_cashier": { "type": "number" },
        "current_stock": { "type": "number" }
      },
      "required": ["prev_stock", "arrived_cartons", "sold_cashier", "current_stock"]
    },
    "DrinksEntry": {
      "title": "DrinksEntry",
      "description": "Drinks inventory tracking and reconciliation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "branch": { "type": "string", "enum": ["القادسية", "المروج"] },
        "pepsi": { "$ref": "#/definitions/DrinkItemState" },
        "sevenup": { "$ref": "#/definitions/DrinkItemState" },
        "dew": { "$ref": "#/definitions/DrinkItemState" },
        "citrus": { "$ref": "#/definitions/DrinkItemState" },
        "pepsi_diet": { "$ref": "#/definitions/DrinkItemState" },
        "sevenup_diet": { "$ref": "#/definitions/DrinkItemState" },
        "dew_diet": { "$ref": "#/definitions/DrinkItemState" },
        "citrus_diet": { "$ref": "#/definitions/DrinkItemState" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "date", "branch", "pepsi", "sevenup", "dew", "citrus", "pepsi_diet", "sevenup_diet", "dew_diet", "citrus_diet"]
    }
  },
  "firestore": {
    "settings": {
      "schema": "Settings",
      "description": "App settings configuration and targets catalog"
    },
    "days": {
      "schema": "DailyEntry",
      "description": "Daily branch ledger calculations database"
    },
    "diesel": {
      "schema": "SharedDiesel",
      "description": "Cross-branch shared diesel cost logs"
    },
    "tax_invoices": {
      "schema": "TaxInvoice",
      "description": "Vendor tax invoices log history"
    },
    "purchases": {
      "schema": "Purchase",
      "description": "Smart system supplier and material purchase tracking database logs"
    },
    "users": {
      "schema": "UnifiedUser",
      "description": "System accounts for managers, accountants, and entry clerks"
    },
    "employees": {
      "schema": "Employee",
      "description": "Registered restaurant staff profiles"
    },
    "employee_advances": {
      "schema": "EmployeeAdvance",
      "description": "Ledger of salary advances"
    },
    "employee_attendance": {
      "schema": "EmployeeAttendance",
      "description": "Daily attendance punch items"
    },
    "whatsapp_settings": {
      "schema": "WhatsAppSettings",
      "description": "Configuration matching physical device state"
    },
    "whatsapp_messages": {
      "schema": "WhatsAppMessage",
      "description": "Audit trails of alerts dispatched to employees"
    },
    "tax_registered_companies": {
      "schema": "TaxCompany",
      "description": "Tax registered suppliers and companies directory for autocomplete"
    },
    "bakery_entries": {
      "schema": "BakeryEntry",
      "description": "Daily bakery bread reconciliation logs"
    },
    "drinks_entries": {
      "schema": "DrinksEntry",
      "description": "Drinks inventory tracking and reconciliation logs"
    }
  }
}
